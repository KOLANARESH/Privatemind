# PrivateMind AI Environment Variables
# Copy this file to .env and fill in your values

DATABASE_URL="file:./dev.db"

# Lyzr Studio AI Agent Integration
LYZR_API_KEY="sk-default-your-api-key-here"
LYZR_AGENT_ID="your-agent-id-here"
LYZR_USER_ID="user@example.com"
LYZR_SESSION_ID="your-agent-id-session-id"
LYZR_ENDPOINT="https://agent-prod.studio.lyzr.ai/v3/inference/chat/"

# Embedding & Search Engine Configuration
# Options: "local-vector" (built-in semantic vector space) | "keyword-fallback"
EMBEDDING_PROVIDER="local-vector"
SIMILARITY_THRESHOLD="0.30"
MAX_RETRIEVAL_CHUNKS="5"

# Security & Private Storage
AUTH_SECRET="your-strong-random-auth-secret"
STORAGE_DIR="./uploads/vault"
MAX_FILE_SIZE_MB="15"
